        "request": "launch",
        "mainClass": "com.rideshare.rideservice.RideServiceApplication",
        "projectName": "ride-service"
    },
    {
        "type": "java",
        "name": "LocationServiceApplication",
        "request": "launch",
        "mainClass": "com.rideshare.location_service.LocationServiceApplication",
        "projectName": "location-service"
    },
    {
        "type": "java",
        "name": "AuthServiceApplication",
        "request": "launch",
        "mainClass": "com.rideshare.auth_service.AuthServiceApplication"
    },
    {
        "type": "java",
        "name": "UserServiceApplication",
        "request": "launch",
        "mainClass": "com.rideshare.user_service.UserServiceApplication"
    },
    {
